# GEMINI_API_KEY: Required for the premium (Gemini) script-writing + TTS path.
# Without it, the app still runs using the free browser-TTS fallback.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional model overrides (see src/lib/radio-core.ts resolveModels):
# GEMINI_SCRIPT_MODEL="gemini-3-flash-preview"
# GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"

# Premium generations allowed per UTC day (0 disables the premium path entirely).
# DAILY_PREMIUM_LIMIT=10

# HTTP port (defaults to 3000).
# PORT=3000

# NVIDIA Riva TTS (optional alternative voice engine via build.nvidia.com).
# Get a key at https://build.nvidia.com (Speech -> Chatterbox Multilingual TTS).
# Never commit real keys. The function-id below is the public NCF endpoint id.
# NVIDIA_API_KEY="nvapi-..."
# NVIDIA_RIVA_FUNCTION_ID="ddacc747-1269-4fab-bfd9-8f593dead106"
# NVIDIA_RIVA_SERVER="grpc.nvcf.nvidia.com:443"
# NVIDIA_RIVA_VOICE="Chatterbox-Multilingual.en-US"
